{
  "name": "@blbaker/daily-dispatch",
  "version": "0.1.0",
  "description": "Turn a day's links into a two-host podcast: pluggable script writers and voice providers, with a CLI.",
  "keywords": [
    "podcast",
    "text-to-speech",
    "tts",
    "elevenlabs",
    "openai",
    "ollama",
    "cli"
  ],
  "homepage": "https://github.com/blbaker/daily-dispatch/tree/main/packages/daily-dispatch#readme",
  "bugs": {
    "url": "https://github.com/blbaker/daily-dispatch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blbaker/daily-dispatch.git",
    "directory": "packages/daily-dispatch"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "daily-dispatch": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "mutate": "node scripts/mutate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
