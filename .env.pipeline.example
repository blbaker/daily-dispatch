# Pushbullet listener (the capture step)
# Get a token from https://www.pushbullet.com/#settings/account
PUSHBULLET_TOKEN=

# Optional: forward every captured link to your own webhook (chat bot,
# automation, whatever). Leave both unset to just capture locally.
HERMES_LINK_WEBHOOK=
HERMES_LINK_WEBHOOK_SECRET=

# Where the pipeline stores captured links, the rendered web app, and
# caches. Defaults to ~/.daily-dispatch if unset.
DAILY_DISPATCH_HOME=

# The backend API (see backend/.env.example for how to get these after
# deploying the CDK stack). Leave unset to run the pipeline without a
# backend -- the archive app still works locally.
DIGEST_API_URL=
DIGEST_API_KEY=

# Podcast framing: who the hosts are reading links from.
LISTENER_NAME=
LISTENER_TOWN=

# Summaries. Defaults to the Claude Code CLI. Must accept the prompt as its
# final argument and print the response to stdout.
SUMMARIZE_CMD=claude -p

# Optional local Ollama fallback for summaries if SUMMARIZE_CMD fails.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# Optional self-hosted Firecrawl (or compatible) instance for JS-heavy
# pages a plain fetch can't read. Leave unset to skip that fallback.
FIRECRAWL_URL=

# ElevenLabs Text-to-Dialogue (podcast generation).
ELEVENLABS_API_KEY=
