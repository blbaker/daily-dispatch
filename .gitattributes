# Check out text files with LF on every OS. Git for Windows and the Windows
# CI runner default to core.autocrlf=true, which would hand bash and Node
# scripts CRLF line endings.
* text=auto eol=lf

# Windows batch files are the exception: cmd.exe expects CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never convert or text-diff these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.apk binary
*.jks binary
*.keystore binary
*.zip binary
*.gz binary
