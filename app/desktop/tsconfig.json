{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "moduleSuffixes": [".impeller", ""],
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "@react-native-async-storage/async-storage": ["./shims/async-storage.ts"],
      "react-native-safe-area-context": ["./shims/safe-area-context.tsx"],
      "expo-status-bar": ["./shims/status-bar.tsx"]
    }
  },
  "include": ["index.ts", "shims/**/*", "gate/**/*.ts", "scripts/**/*.mts"],
  "exclude": ["node_modules", "build", "dist"]
}
