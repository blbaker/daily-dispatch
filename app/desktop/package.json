{
  "name": "daily-dispatch-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop host for the Daily Dispatch app (macOS, Linux, Windows) on react-native-impeller-platform",
  "scripts": {
    "bundle": "node scripts/desktop.mts bundle",
    "desktop": "node scripts/desktop.mts run",
    "demo": "node scripts/desktop.mts demo",
    "package": "node scripts/package.mts",
    "gate": "node scripts/gate.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-impeller-platform": "0.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
