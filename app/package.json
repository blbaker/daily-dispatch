{
  "name": "daily-digest-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "desktop:install": "npm --prefix desktop ci",
    "desktop": "npm --prefix desktop run desktop",
    "desktop:demo": "npm --prefix desktop run demo",
    "desktop:bundle": "npm --prefix desktop run bundle",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:gate": "npm --prefix desktop run gate",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "typecheck": "tsc --noEmit && tsc -p e2e && tsc -p sw --noEmit",
    "e2e:screens": "node e2e/screens.ts",
    "test": "vitest run",
    "build:sw": "tsc -p sw",
    "e2e:webpush": "node e2e/webpush.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.0",
    "expo": "~54.0.0",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-intent-launcher": "~13.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~6.0.9",
    "react": "19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.81.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "24.19.2",
    "@types/react": "~19.0.0",
    "playwright": "1.62.1",
    "typescript": "~5.6.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "private": true
}
