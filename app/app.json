{
  "expo": {
    "name": "Daily Dispatch",
    "slug": "daily-dispatch",
    "version": "1.0.209",
    "orientation": "portrait",
    "scheme": "dailydispatch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.baker.dailydispatch",
      "versionCode": 209,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eink": false
    },
    "ios": {
      "bundleIdentifier": "com.baker.dailydispatch",
      "userInterfaceStyle": "automatic"
    }
  }
}
