# Used by `cdk deploy` (run manually by a maintainer, never in CI).
# AWS account/region the stack deploys to.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-west-2

# The single-user API key the Lambda checks on every request. Generate one
# with: openssl rand -hex 32
# Pass it at deploy time, never commit it:
#   cdk deploy -c apiKey="$(cat path/to/api-key)"

# scripts/release.sh and scripts/publish_release.py (in-app APK updates,
# also run by hand). RELEASE_BUCKET is the ReleaseBucketOut stack output.
RELEASE_BUCKET=
AWS_REGION=us-west-2
# Where built APKs land. Defaults to ~/daily-dispatch-apks.
APK_OUT_DIR=
# Optional: also copy the APKs into this directory (a LAN download folder).
APK_MIRROR_DIR=
# Set to 0 to build without publishing.
PUBLISH=1
